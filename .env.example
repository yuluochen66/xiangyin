# =====================================================================
# 乡音有据 · 前端环境变量示例
# ---------------------------------------------------------------------
# 【重要】本文件只包含「变量名 + 占位说明 + 非敏感默认值」。
#         任何真实密钥、令牌、密码、私钥都不得写入本文件，也不得写入
#         任何会被提交的 .env 文件。
#
# 本项目前端**不需要任何密钥**，原因见下：
#   - 所有接口的鉴权走「用户登录后拿到的 token」，由使用者在浏览器里产生，
#     存在 localStorage（键名见 VITE_AUTH_TOKEN_KEY），从不进入代码或仓库；
#   - 前端代码里没有任何服务端凭据、第三方平台 Secret 或数据库连接串。
#     如果你在新增功能时需要引入这类东西，**必须**放到服务端，前端只调你自己的接口。
#
# 约定：
#   1. 只有 VITE_ 前缀的变量会被 Vite 注入到客户端（import.meta.env）；
#   2. ⚠️ VITE_ 变量会被**打包进前端产物**，等于公开——绝不可放密钥；
#   3. 所有变量都是字符串，类型转换统一在 src/config/env.ts 内完成，
#      业务代码不得直接读 import.meta.env；
#   4. 每个变量都有代码内默认值，缺失时项目仍可独立运行。
#
# 用法：复制本文件为 .env.local（本机开发）或 .env.production（部署），再按需覆盖。
#   .env / .env.* 已被 .gitignore 排除，不会进入仓库。
# =====================================================================

# ---------- 接口 ----------

# 后端接口基址（网关 / BFF）。用相对路径 /api 表示走同源代理。
VITE_API_BASE_URL=/api

# 是否启用本地 mock 数据层。
#   true  = 全部接口走 src/mock，无需后端即可跑通 7 个流程
#   false = 走真实 HTTP，联调时改成 false
VITE_USE_MOCK=true

# ---------- Mock 行为（仅 mock 模式生效） ----------

# mock 模拟网络延迟基准（毫秒），用于验证「加载中」状态。
VITE_MOCK_LATENCY_MS=420

# mock 随机失败率 0~1，用于验证「失败」与「重试」状态。0 = 不随机失败。
VITE_MOCK_FAILURE_RATE=0

# ---------- 请求策略 ----------

# 单次请求默认超时（毫秒）。注意：长耗时 AI 接口应改成异步任务 + 轮询，不要靠调大超时。
VITE_REQUEST_TIMEOUT_MS=15000

# 失败自动重试次数。仅对 network / timeout / server 三类错误生效。
# 非幂等的 POST 接口请在前端单独设 maxRetries: 0（见交接文档 D-08）。
VITE_REQUEST_MAX_RETRIES=2

# ---------- 鉴权（占位实现） ----------

# 用户 token 在 localStorage 中的键名。这是「键名」，不是密钥本身。
VITE_AUTH_TOKEN_KEY=xiangyin_token

# 401 后跳转的登录页路径占位。真实登录方案待后端确定（见交接文档 D-06）。
VITE_LOGIN_PATH=/login

# ---------- 站点 ----------

VITE_APP_TITLE=乡音有据 · 福州地方文化口述整理与共创智能体

# =====================================================================
# 部署到生产环境时（.env.production 同样被 .gitignore 排除，需自行创建）：
#
#   VITE_API_BASE_URL=https://your-api.example.com
#   VITE_USE_MOCK=false
#
# 若不创建该文件，构建产物会使用代码内默认值（VITE_USE_MOCK 默认 true），
# 即以 mock 模式发布——这在演示站点是可以接受的，正式环境请显式关闭。
# =====================================================================
