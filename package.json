{
  "name": "review-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "node scripts/gen-api-doc.mjs",
    "docs:handoff": "node scripts/gen-handoff-doc.mjs",
    "docs:components": "node scripts/gen-component-doc.mjs",
    "smoke": "node scripts/smoke-mock.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  }
}
